# Copie para .env e ajuste conforme necessário. Usado pelo docker-compose.
POSTGRES_USER=capmar
POSTGRES_PASSWORD=capmar
POSTGRES_DB=capmar

# URL pública da API consumida pelo frontend (build-time + runtime).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origens permitidas no CORS do backend.
CORS_ORIGINS=http://localhost:3000

# Chave de assinatura dos JWTs. OBRIGATÓRIA — gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Validade do token, em minutos (padrão: 7 dias).
ACCESS_TOKEN_EXPIRE_MINUTES=10080
