# Copie para .env e ajuste conforme necessário. Usado pelo docker-compose.
POSTGRES_USER=capmar
POSTGRES_PASSWORD=capmar
POSTGRES_DB=capmar

# URL pública da API consumida pelo frontend (build-time + runtime).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origens permitidas no CORS do backend.
CORS_ORIGINS=http://localhost:3000

# Chave de assinatura dos JWTs. OBRIGATÓRIA — gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Validade do token, em minutos (padrão: 7 dias).
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Cookie HttpOnly que carrega o JWT. Em produção (HTTPS): COOKIE_SECURE=true.
# Em desenvolvimento local (HTTP) precisa ficar false, senão o navegador
# descarta o cookie e o login não persiste.
COOKIE_SECURE=false
# lax | strict | none — `none` exige COOKIE_SECURE=true e só é necessário se
# o frontend e a API ficarem em domínios diferentes (ver spec §4.1).
COOKIE_SAMESITE=lax
