# Copie para .env e ajuste conforme necessário. Usado pelo docker-compose.
POSTGRES_USER=capmar
POSTGRES_PASSWORD=capmar
POSTGRES_DB=capmar

# URL pública da API consumida pelo frontend (build-time + runtime).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origens permitidas no CORS do backend.
CORS_ORIGINS=http://localhost:3000

# Desenvolvimento local. Produção: use docker-compose.production.yml e docs/seguranca-integridade.md.
ENVIRONMENT=development
SECRET_KEY=dev-secret-change-me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Somente IPs dos proxies confiáveis; nunca use *.
FORWARDED_ALLOW_IPS=127.0.0.1
