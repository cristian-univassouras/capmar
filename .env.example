# Copie para .env e ajuste conforme necessário. Usado pelo docker-compose.
POSTGRES_USER=capmar
POSTGRES_PASSWORD=capmar
POSTGRES_DB=capmar

# URL pública da API consumida pelo frontend (build-time + runtime).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origens permitidas no CORS do backend.
CORS_ORIGINS=http://localhost:3000

# Desenvolvimento local. Produção: use docker-compose.production.yml e docs/seguranca-integridade.md.
ENVIRONMENT=development
SECRET_KEY=dev-secret-change-me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Somente IPs dos proxies confiáveis; nunca use *.
FORWARDED_ALLOW_IPS=127.0.0.1

# Porta local do site; altere também SITE_URL e CORS_ORIGINS se a porta estiver ocupada.
FRONTEND_PORT=3000
SITE_URL=http://localhost:3000
# Mailpit captura mensagens localmente em http://localhost:8025.
# Produção exige servidor/remetente próprios e STARTTLS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=CapMar <noreply@capmar.local>
SMTP_USERNAME=
SMTP_PASSWORD=
