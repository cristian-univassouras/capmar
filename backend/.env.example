# Conexão com o Postgres. No docker-compose o host é "db"; localmente, "localhost".
DATABASE_URL=postgresql+psycopg2://capmar:capmar@localhost:5432/capmar

# Origens permitidas para CORS (separadas por vírgula).
CORS_ORIGINS=http://localhost:3000

ENVIRONMENT=development
SECRET_KEY=dev-secret-change-me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_QUOTA_BYTES=52428800
UPLOAD_QUOTA_COUNT=100
UPLOAD_ORPHAN_HOURS=24
LOGIN_LIMIT=10
REGISTER_LIMIT=5
WRITE_LIMIT=120
# Credencial separada: usar apenas no processo alembic, nunca no backend.
# MIGRATION_DATABASE_URL=postgresql+psycopg2://...
